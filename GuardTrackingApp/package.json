{
  "name": "TracSOpro",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=standardDebug --appId=com.tracsopro",
    "android:release": "cd android && gradlew.bat assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "android:release:local": "powershell -ExecutionPolicy Bypass -File scripts/build-local-release-apk.ps1",
    "android:debug:local": "powershell -ExecutionPolicy Bypass -File scripts/build-local-debug-apk.ps1",
    "android:phone": "powershell -ExecutionPolicy Bypass -File scripts/build-phone-apk.ps1",
    "android:install:local": "powershell -ExecutionPolicy Bypass -File scripts/install-local-apk.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "e2e:build:android": "detox build -c android.emu.debug",
    "e2e:test:android": "detox test -c android.emu.debug",
    "e2e:android": "npm run e2e:build:android && npm run e2e:test:android",
    "e2e:build:ios": "detox build -c ios.sim.debug",
    "e2e:test:ios": "detox test -c ios.sim.debug",
    "e2e:test:ios:ci": "detox test -c ios.sim.debug e2e/loginAuth.e2e.js e2e/clientPortal.e2e.js e2e/adminPortal.e2e.js",
    "e2e:ios": "npm run e2e:build:ios && npm run e2e:test:ios",
    "e2e:ios:ci": "npm run e2e:build:ios && npm run e2e:test:ios:ci",
    "postinstall": "patch-package && node scripts/fix-push-notification-gradle.js && (node scripts/fix-vector-icons.js || powershell -ExecutionPolicy Bypass -File scripts/fix-vector-icons.ps1 || bash scripts/fix-vector-icons.sh)",
    "fix:vector-icons": "node scripts/fix-vector-icons.js || powershell -ExecutionPolicy Bypass -File scripts/fix-vector-icons.ps1 || bash scripts/fix-vector-icons.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/messaging": "^23.4.1",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.5.0",
    "@reduxjs/toolkit": "^2.9.2",
    "@stripe/stripe-react-native": "^0.37.2",
    "axios": "^1.12.2",
    "react": "19.1.1",
    "react-native": "^0.82.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-feather": "^1.1.2",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-maps": "^1.26.18",
    "react-native-network-logger": "^2.0.1",
    "react-native-push-notification": "^8.1.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.1.0",
    "react-native-svg": "^15.14.0",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/helper-define-polyfill-provider": "^0.6.5",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@jridgewell/source-map": "^0.3.11",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.2",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.28.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^30.2.0",
    "jetifier": "^2.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
