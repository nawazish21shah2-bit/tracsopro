{
  "name": "guard-tracking-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server-db.ts",
    "dev:db": "tsx watch src/server-db.ts",
    "start": "npx tsx src/server-db.ts",
    "build": "npx prisma generate",
    "test": "tsx --test tests/**/*.test.ts",
    "test:coverage": "c8 --reporter=text-summary --include=src/utils --include=src/validators --include=src/middleware/errorHandler.ts --include=src/middleware/validate.ts --include=src/services/storageService.ts --include=src/services/subscriptionService.ts --include=src/services/shift/geofenceService.ts --include=src/services/shift/types.ts --include=src/services/shift/transformShift.ts --check-coverage --lines 50 --functions 50 --branches 50 --statements 50 tsx --test tests/**/*.test.ts",
    "test:coverage:all": "c8 --reporter=text-summary --check-coverage --lines 60 --functions 60 --branches 57 --statements 60 --exclude=src/services/chatService.ts tsx --test tests/**/*.test.ts",
    "test:tenant": "tsx --test tests/tenantIsolation.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "scan:secrets": "node scripts/scan-secrets.mjs --all",
    "scan:secrets:staged": "node scripts/scan-secrets.mjs --staged",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "seed:e2e": "tsx scripts/seed-e2e-user.ts",
    "db:seed-shifts": "tsx prisma/seed-shifts.ts",
    "db:seed-ongoing-shifts": "tsx prisma/seed-ongoing-shifts.ts",
    "db:seed-reports": "node scripts/seed-reports.js",
    "db:seed-test-roles": "node scripts/seed-test-roles-client.js",
    "db:seed-notifications": "tsx prisma/seed-notifications.ts",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:push && npm run db:generate && npm run db:seed",
    "worker:push-retry": "tsx src/jobs/pushRetryWorker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@prisma/adapter-pg": "^6.18.0",
    "@prisma/client": "^6.19.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.6.1",
    "bullmq": "^5.49.1",
    "stripe": "^14.9.0",
    "@sentry/node": "^9.15.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.2",
    "uuid": "^11.0.2",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^7.0.3",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.0",
    "supertest": "^7.1.0",
    "typescript": "^5.6.3",
    "c8": "^10.1.3",
    "eslint": "^9.22.0",
    "typescript-eslint": "^8.26.0",
    "@eslint/js": "^9.22.0"
  }
}
